<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="658.0" prefWidth="944.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.SecondaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <TextArea fx:id="chatArea" prefHeight="546.0" prefWidth="904.0" VBox.vgrow="ALWAYS">
         <VBox.margin>
            <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin></TextArea>
      <HBox prefHeight="31.0" prefWidth="825.0">
         <children>
            <TextField fx:id="textInputBar" alignment="BASELINE_LEFT" prefHeight="20.0" prefWidth="747.0" promptText="Scrivi un messaggio..." HBox.hgrow="ALWAYS" />
            <Region prefHeight="26.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendBtn" alignment="CENTER_RIGHT" mnemonicParsing="false" onAction="#sendMessage" text="Invia" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
