<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="324.0" prefWidth="496.0" spacing="25.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unisa.PrimaryController">
   <children>
      <Label text="Vuoi essere il Server?">
         <font>
            <Font size="18.0" />
         </font></Label>
      <HBox alignment="CENTER" prefHeight="35.0" prefWidth="242.0">
         <children>
            <Button fx:id="yesBtn" onAction="#serverSideSwitch" prefHeight="31.0" prefWidth="44.0" text="Si">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
            <Region prefHeight="35.0" prefWidth="65.0" />
            <Button fx:id="noBtn" onAction="#clientSideSwitch" prefHeight="31.0" prefWidth="43.0" text="No">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
